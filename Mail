from pyspark.sql import functions as F

table_list = [
    'CLM_LN_PHRM_MV', 'CLM_LN_PHRM_EXT_MV', 'CLM_LN_PHRM_RJCT_MV',
    'CLM_LN_PHRM_TRNSCTN_REIMB_SV', 'CLM_LN_PHRM_TRNSCTN_REIMB_EXT_SV',
    'CLM_LN_PHRM_TRNSCTN_REIMB_INCRMTL_SV', 'CLM_LN_PHRM_TRNSCTN_REIMB_INCRMTL_EXT_SV',
    'CLM_SAVE_OPPOR_KPI_INCRMTL_SV'
]

# a: table_columns_count per TableName
a = (
    spark.table("usm_dev.ccw_audmstr_rawz.data_product_column_metadata")
    .filter(F.col("TableName").isin(table_list))
    .groupBy("TableName")
    .agg(F.countDistinct("ColumnName").alias("table_columns_count"))
)

# b: used_columns per Table_Name, source
b = (
    spark.table("usm_dev.ccw_audmstr_cnfz.column_usage_metrics")
    .filter(F.col("Table_Name").isin(table_list))
    .groupBy("Table_Name", "source")
    .agg(F.countDistinct("Column_Name").alias("used_columns"))
)

# c: join a and b, compute unused_column
c = (
    a.join(b, a["TableName"] == b["Table_Name"], "left")
    .select(
        a["TableName"],
        a["table_columns_count"],
        b["used_columns"],
        (a["table_columns_count"] - b["used_columns"]).alias("unused_column"),
        b["source"]
    )
)

# Final aggregation
unused_column_count_df = (
    c.groupBy("source")
    .agg(
        F.sum("used_columns").alias("total_used_column"),
        F.sum("table_columns_count").alias("total_columns"),
        F.sum("unused_column").alias("total_unused_column")
    )
    .select("total_used_column", "total_columns", "total_unused_column", "source")
)
