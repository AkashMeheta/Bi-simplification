from pyspark.sql import functions as F

table_list = [
    'CLM_LN_PHRM_MV', 'CLM_LN_PHRM_EXT_MV', 'CLM_LN_PHRM_RJCT_MV',
    'CLM_LN_PHRM_TRNSCTN_REIMB_SV', 'CLM_LN_PHRM_TRNSCTN_REIMB_EXT_SV',
    'CLM_LN_PHRM_TRNSCTN_REIMB_INCRMTL_SV',
    'CLM_LN_PHRM_TRNSCTN_REIMB_INCRMTL_EXT_SV',
    'CLM_SAVE_OPPOR_KPI_INCRMTL_SV'
]

# base table
table1 = spark.table("usm_dev.ccw_dpoptmz_rawz.data_product_column_metadata")

# usage metrics table, filtered (this replaces the inner subquery)
usage_metrics = (
    spark.table("usm_dev.ccw_dpoptmz_cnfz.column_usage_metrics")
    .filter(
        F.col("Table_Name").isin(table_list) &
        (F.col("source") == "Teradata")
    )
    .select(
        F.col("Table_Name").alias("TableName"),
        F.col("Column_Name").alias("ColumnName")
    )
    .distinct()
)

# table2 equivalent: table1 rows whose (TableName, ColumnName) exist in usage_metrics
# a left_semi join is the DataFrame equivalent of "WHERE (col1,col2) IN (subquery)"
table2 = (
    table1
    .join(usage_metrics, on=["TableName", "ColumnName"], how="left_semi")
    .select("TableName", "ColumnName")
    .distinct()
)
